[["", "http://www.afvclub.com/account/register/organization/28?utm_campaign=Prospecting_Affiliate_AFVC_AFAWebskin_Oct_FY26&utm_source=Website_banner&utm_medium=partner-website_awareness&utm_content=image_general"], ["", "http://www.afvclub.com/account/register/organization/28?utm_campaign=Prospecting_Affiliate_AFVC_AFAWebskin_Oct_FY26&utm_source=Website_banner&utm_medium=partner-website_awareness&utm_content=image_general"], ["", "https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fwww.airandspaceforces.com%2Fthefarahreport%2F"], ["", "https://twitter.com/intent/tweet?url=https%3A%2F%2Fwww.airandspaceforces.com%2Fthefarahreport%2F&text=The+Farah+Report"], ["", "https://www.linkedin.com/shareArticle?url=https%3A%2F%2Fwww.airandspaceforces.com%2Fthefarahreport%2F&title=The+Farah+Report&summary=US+Central+Command+on+Friday+released+the+%3Ca+href%3D%22%2FSiteCollectionDocuments%2FReports%2F2009%2FJune%25202009%2FDay22%2Fuscentcom_farah061809.pdf%22%3Eexecutive+summary%3C%2Fa%3E+%28fairly+large+file%29+of+the+report+on+the+investigation+into+the+civilian+casualties+that+resulted+from+%3Ca+href%3D%22%2Fmorehindsight%2F%22%3Ethe+May+4+battle%3C%2Fa%3E+between+Taliban+insurgents+and+Afghanistan+and+coalition+forces+in+Farah+province.+The+conclusion+was+that+there+were+likely+at+least+26%E2%80%94and+possibly+more%E2%80%94civilian+casualties%2C+but+that+the+US+aircraft+strikes+were+lawful+within+%22the+totality+of+the+circumstances.%22+The+report+does+not+recommend+eliminating+the+use+of+close+air+support%2C+%22especially+in+direct+and+indirect+fire+situations+that+imperil+friendly+forces%3B%22+however+it+does+caution+that+%22absent+a+direct+or+imminent+threat%2C+we+must+pursue+a+tactical+approach+that+prioritizes+avoidance+of+civilian+casualties+as+a+fundamental+aspect+of+mission+success.%22+It+notes+that+two+of+three+B-1B+strikes+that+took+place+after+sunset+in+the+nearly+eight-hour+confrontation+could+have+caused+civilian+casualties.+The+ground+force+commander+determined+that+coalition+and+Afghan+forces+were+in+danger+and+gave+the+strike+orders%2C+but+neither+the+ground+force+commander+nor+the+aircrew+could+confirm+the+presence+or+absence+of+civilians+in+the+target+buildings%2C+which+is+why+the+investigators+believe+the+two+CAS+strikes+were+each+%22a+likely+source+of+civilian+casualties.%22+Among+several+recommendations%2C+the+report+calls+for+coalition+forces+to+refine+guidance+for+employment+of+weapons+when+there+is+potential+for+civilian+casualties.+It+also+calls+for+a+review+of+aircraft+used+in+CAS+roles+for+%22appropriateness%22+and+for+%22any+shortfalls+with+respect+to+the+maintenance+of+positive+identification.%22&source=Air+%26amp%3B+Space+Forces+Magazine&mini=true"], ["", "https://www.reddit.com/submit?url=https%3A%2F%2Fwww.airandspaceforces.com%2Fthefarahreport%2F&title=The+Farah+Report"], ["", "https://bsky.app/intent/compose?text=The+Farah+Report%20https%3A%2F%2Fwww.airandspaceforces.com%2Fthefarahreport%2F"], ["executive summary", "/PDF/SiteCollectionDocuments/Reports/2009/June%202009/Day22/uscentcom_farah061809.pdf"], ["the May 4 battle", "/morehindsight/"], ["Air Force Launches ARRW, Its First Hypersonic Weapon, into Production", "/air-force-launches-arrw-its-first-hypersonic-weapon-into-production/"], ["Air Force Plans $1 Billion Campus for Testing F-47 at Nellis", "/air-force-billion-dollar-campus-testing-f-47-nellis/"], ["Space Force Wants Cislunar Kit Ready to Launch by 2029", "/space-force-cislunar-kit-2029-launch/"], ["Pentagon Starting with Resilient Energy for Sweeping \u2018FORTRESS America\u2019 Project", "/pentagon-resilient-energy-fortress-america-project/"], ["", "https://www.airandspaceforces.com/former-airmen-running-in-the-2026-midterms/"], ["Dozens of Former Airmen Are Running in the \u201926 Midterms", "https://www.airandspaceforces.com/former-airmen-running-in-the-2026-midterms/"], ["", "https://www.airandspaceforces.com/pentagon-finance-second-launch-pad-stoke-space/"], ["Pentagon to Give Sta