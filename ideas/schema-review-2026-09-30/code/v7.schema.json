{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchbook.local/v7.schema.json",
  "title": "Benchbook v7, spec v2: catalog or decision record (SPEC-v7-v2 sections 1-2)",
  "type": "object",
  "oneOf": [
    {"required": ["catalog"], "properties": {"catalog": {"$ref": "#/$defs/catalog"}}},
    {"required": ["record"], "properties": {"record": {"$ref": "#/$defs/record"}}}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "side": {"type": "string", "pattern": "^[A-Z]$"},
    "strength": {"enum": ["weak", "strong"]},
    "equityMap": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/strength"}},
    "tag": {"type": "string", "pattern": "^([A-Za-z0-9_-]+(@[A-Za-z0-9_]+)?|cond\\.[A-Za-z0-9_.-]+)$"},
    "tags": {"type": "array", "items": {"$ref": "#/$defs/tag"}},
    "condition": {"type": "string", "pattern": "^cond\\.[A-Za-z0-9_.-]+$"},
    "conditions": {"type": "array", "items": {"$ref": "#/$defs/tag"}},
    "tier": {"type": "string", "pattern": "^T[0-9]+$"},
    "strList": {"type": "array", "items": {"type": "string"}},
    "strOrList": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
    "likelihood": {"enum": ["almost_no_chance", "very_unlikely", "unlikely", "even", "likely", "very_likely", "almost_certain"]},
    "sideOrNull": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/side"}]},

    "catalog": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"type": "string"},
        "imports": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+@[A-Za-z0-9._-]+$"}},
        "issues": {"type": "object", "additionalProperties": {"$ref": "#/$defs/issue"}},
        "equities": {"type": ["object", "null"], "additionalProperties": {"type": "object", "properties": {
          "text": {"type": "string"}, "residue": {"$ref": "#/$defs/strList"}}}},
        "dimensions": {"type": ["object", "null"], "additionalProperties": {"oneOf": [
          {"type": "array", "items": {"type": "string"}, "minItems": 1},
          {"type": "object", "required": ["rungs"], "properties": {
            "rungs": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "mirror": {"type": "boolean"}}}]}},
        "factors": {"type": ["object", "null"], "additionalProperties": {"$ref": "#/$defs/factor"}},
        "conditions": {"type": ["object", "null"], "propertyNames": {"$ref": "#/$defs/condition"},
          "additionalProperties": {"type": "object", "required": ["text"], "properties": {
            "text": {"type": "string"}, "unreachable": {"type": "string"}, "kind": {"enum": ["frame", "determination"]},
            "established_by": {"type": "array", "items": {"type": "object", "required": ["holder"], "properties": {
              "holder": {"type": "string"}, "form": {"type": "string"}}}}}}},
        "actions": {"type": ["object", "null"], "additionalProperties": {"type": "object", "required": ["direction"], "properties": {
          "direction": {"enum": ["permissive", "restrictive"]}, "reversible": {"type": "boolean"},
          "tier": {"$ref": "#/$defs/tier"}}}},
        "prohibitions": {"type": "array", "items": {"type": "object", "required": ["id", "forbids"], "properties": {
          "id": {"type": "string"}, "forbids": {"type": "object", "required": ["action"], "properties": {"action": {"type": "string"}}},
          "when": {"$ref": "#/$defs/conditions"}, "unless": {"$ref": "#/$defs/conditions"}, "cite": {"type": "string"}}}},
        "authority": {"type": "object", "required": ["levels", "tiers", "roles"], "properties": {
          "levels": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "tiers": {"type": "object", "propertyNames": {"$ref": "#/$defs/tier"}, "additionalProperties": {"type": "string"}},
          "roles": {"type": "object", "properties": {"none": {"type": "null"}},
                    "additionalProperties": {"type": ["string", "null"]}},
          "tier_floors": {"type": ["object", "null"], "additionalProperties": {"$ref": "#/$defs/tier"}},
          "non_delegable_to_agent": {"type": ["array", "null"], "items": {"type": "string"}},
          "inherent": {"type": ["array", "null"], "items": {"type": "string"}},
          "irreversible_bump": {"type": "integer", "minimum": 0}}},
        "stakes": {"type": "object", "propertyNames": {"$ref": "#/$defs/tier"}, "additionalProperties": {
          "type": "object", "required": ["L", "k"], "properties": {
            "L": {"type": "number", "exclusiveMinimum": 0}, "k": {"type": "number", "minimum": 0}}}},
        "coupling": {"type": ["array", "null"], "items": {"type": "object", "required": ["if", "then"], "properties": {
          "if": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": {"$ref": "#/$defs/side"}},
          "then": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": {"$ref": "#/$defs/side"}}}}}
      }
    },
    "issue": {
      "type": "object", "required": ["question", "sides", "action", "default"],
      "properties": {
        "question": {"type": "string"},
        "sides": {"type": "object", "minProperties": 2, "maxProperties": 2, "propertyNames": {"$ref": "#/$defs/side"}},
        "action": {"type": "object", "minProperties": 2, "maxProperties": 2, "propertyNames": {"$ref": "#/$defs/side"},
                   "additionalProperties": {"type": "string"}},
        "default": {"$ref": "#/$defs/side"}
      }
    },
    "factor": {
      "type": "object", "required": ["issue", "favors", "text", "equities"],
      "properties": {
        "issue": {"type": "string"}, "favors": {"$ref": "#/$defs/side"}, "text": {"type": "string"},
        "equities": {"oneOf": [{"$ref": "#/$defs/equityMap"}, {"type": "array", "items": {"type": "string"}, "minItems": 1}]},
        "dimension": {"type": "string"},
        "rungs": {"type": "object", "minProperties": 1, "additionalProperties": {"oneOf": [
          {"$ref": "#/$defs/strength"}, {"$ref": "#/$defs/equityMap"}]}},
        "knockout": {"type": "boolean"}, "conjunctive": {"type": "boolean"},
        "mirror_of": {"type": "string"}, "flag": {"type": "string"}
      },
      "dependentRequired": {"rungs": ["dimension"], "dimension": ["rungs"]},
      "if": {"properties": {"equities": {"type": "array"}}, "required": ["equities"]},
      "then": {"required": ["rungs"]}
    },

    "record": {
      "type": "object",
      "required": ["id", "catalog", "provenance", "situation", "resolution"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"type": "string"},
        "catalog": {"type": "string", "pattern": "^[A-Za-z0-9_-]+@[A-Za-z0-9._-]+$"},
        "provenance": {"type": "object", "required": ["kind", "gold_kind"], "properties": {
          "kind": {"enum": ["authored", "adjudicated", "investigated", "teaching"]},
          "gold_kind": {"enum": ["ruling", "review_finding", "recommendation", "teaching"]},
          "authority": {"type": "object", "properties": {
            "rank": {"type": ["number", "null"]}, "status": {"enum": ["current", "revised", "superseded", "withdrawn"]}}}}},
        "units": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {
          "id": {"type": "string"}, "class": {"type": "string"}, "count": {"type": "integer"}}}},
        "situation": {"$ref": "#/$defs/situation"},
        "resolution": {"$ref": "#/$defs/resolution"},
        "guidance": {"$ref": "#/$defs/guidance"},
        "review": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/review"}]}
      }
    },
    "situation": {
      "type": "object", "required": ["agent", "facts", "authority"],
      "properties": {
        "agent": {"type": "object", "required": ["role"], "properties": {
          "role": {"enum": ["none", "recommend", "execute", "decide"]}, "serves": {"type": "string"}}},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "uncertain": {"oneOf": [
          {"type": "array", "items": {"type": "object", "required": ["tag", "values"], "properties": {
            "tag": {"$ref": "#/$defs/tag"}, "values": {"type": "array", "items": {"type": "string"}, "minItems": 2}}}},
          {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}, "minItems": 2}}]},
        "authority": {"type": "object", "properties": {
          "deciders": {"type": "array", "items": {"type": "object", "required": ["holder", "holds"], "properties": {
            "holder": {"type": "string"}, "holds": {"$ref": "#/$defs/strList"}, "level": {"type": "string"}}}},
          "delegations": {"type": "array", "items": {"type": "object", "required": ["holds"], "properties": {
            "id": {"type": "string"}, "to": {"type": "string"}, "holds": {"$ref": "#/$defs/strList"},
            "when": {"$ref": "#/$defs/conditions"}, "covers_floors": {"$ref": "#/$defs/tags"},
            "duties": {"$ref": "#/$defs/strList"}, "source": {"type": "string"}}}},
          "orders": {"type": "array", "items": {"$ref": "#/$defs/order"}},
          "requests": {"type": "array", "items": {"type": "object"}}}},
        "options": {"type": "array", "items": {"type": "object", "required": ["text", "plan"], "properties": {
          "text": {"type": "string"}, "plan": {"type": "array", "items": {"$ref": "#/$defs/planAtom"}}}}}
      }
    },
    "order": {
      "type": "object", "required": ["directs"],
      "properties": {
        "id": {"type": "string"}, "from": {"type": "string"},
        "directs": {"type": "object", "required": ["issue", "side"], "properties": {
          "issue": {"type": "string"}, "side": {"$ref": "#/$defs/side"}, "units": {"$ref": "#/$defs/strList"}}},
        "excludes": {"$ref": "#/$defs/strList"}, "excludes_when": {"$ref": "#/$defs/conditions"},
        "active_when": {"$ref": "#/$defs/conditions"}, "disabled_by": {"$ref": "#/$defs/conditions"},
        "superseded_by": {"$ref": "#/$defs/conditions"}
      }
    },
    "fact": {
      "type": "object", "required": ["id", "text", "status", "channel", "tags"],
      "properties": {
        "id": {"type": "string"}, "text": {"type": "string"},
        "status": {"enum": ["observed", "reported", "assessed", "alleged", "admitted", "found", "determination", "disputed", "rejected"]},
        "channel": {"enum": ["principal", "data", "sensor", "record"]},
        "likelihood": {"$ref": "#/$defs/likelihood"}, "confidence": {"enum": ["low", "moderate", "high"]},
        "tags": {"type": "array", "items": {"$ref": "#/$defs/tag"}, "uniqueItems": true},
        "about": {"$ref": "#/$defs/strOrList"}, "use": {"enum": ["all", "credibility_only"]},
        "by": {"type": "string"}, "form": {"type": "string"},
        "credibility": {"enum": ["credited", "discredited", "not_assessed"]},
        "known_at_decision": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "assessed"}}}, "then": {"required": ["likelihood", "confidence"]}},
        {"if": {"properties": {"status": {"const": "determination"}}}, "then": {"required": ["by"]}}
      ]
    },
    "planAtom": {
      "type": "object", "required": ["act"],
      "properties": {
        "act": {"enum": ["proceed", "route", "contingent", "residue", "duty"]}, "issue": {"type": "string"},
        "side": {"$ref": "#/$defs/side"}, "to": {"$ref": "#/$defs/strOrList"}, "recommend": {"$ref": "#/$defs/sideOrNull"},
        "because": {"enum": ["authorize", "inform", "flag"]}, "units": {"$ref": "#/$defs/strList"},
        "interim": {"type": "boolean"}, "when": {"$ref": "#/$defs/conditions"},
        "then": {"type": "object", "required": ["issue", "side"]}, "atoms": {"$ref": "#/$defs/strList"}
      },
      "allOf": [
        {"if": {"properties": {"act": {"const": "proceed"}}}, "then": {"required": ["issue", "side"]}},
        {"if": {"properties": {"act": {"const": "route"}}}, "then": {"required": ["issue"]}},
        {"if": {"properties": {"act": {"const": "contingent"}}}, "then": {"required": ["when", "then"]}},
        {"if": {"properties": {"act": {"enum": ["residue", "duty"]}}}, "then": {"required": ["atoms"]}}
      ]
    },
    "holding": {
      "type": "object", "required": ["issue", "outcome", "force"],
      "properties": {
        "issue": {"type": "string"}, "units": {"$ref": "#/$defs/strList"}, "outcome": {"$ref": "#/$defs/side"},
        "reason": {"type": "array", "items": {"$ref": "#/$defs/tag"}, "minItems": 1},
        "reason_alts": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"$ref": "#/$defs/tag"}, "minItems": 1}},
        "force": {"enum": ["required", "permitted"]}
      },
      "oneOf": [{"required": ["reason"]}, {"required": ["reason_alts"]}]
    },
    "resolution": {
      "type": "object", "required": ["holdings", "plan", "status"],
      "properties": {
        "holdings": {"type": "array", "items": {"$ref": "#/$defs/holding"}},
        "routed": {"type": "array", "items": {"type": "object", "required": ["issue", "because"], "properties": {
          "issue": {"type": "string"}, "side": {"$ref": "#/$defs/side"}, "because": {"enum": ["authorize", "inform", "flag"]},
          "to": {"$ref": "#/$defs/strOrList"}, "interim": {"$ref": "#/$defs/sideOrNull"}, "units": {"$ref": "#/$defs/strList"}}}},
        "plan": {"type": "array", "items": {"$ref": "#/$defs/planAtom"}},
        "status": {"enum": ["settled", "contested"]},
        "hidden_resolution": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/side"}}]},
        "holding_text": {"type": "string"}
      }
    },
    "clause": {
      "type": "object", "required": ["issue"],
      "properties": {"issue": {"type": "string"}, "units": {"$ref": "#/$defs/strList"}, "outcome": {"$ref": "#/$defs/side"},
                     "force": {"enum": ["required", "permitted"]}, "route": {"enum": ["authorize", "inform", "flag"]},
                     "side": {"$ref": "#/$defs/side"}, "to": {"$ref": "#/$defs/strOrList"}}
    },
    "guidance": {
      "type": "object",
      "properties": {
        "flips": {"type": "array", "items": {"type": "object", "required": ["id", "change", "then"], "properties": {
          "id": {"type": "string"},
          "event": {"enum": ["world", "decision", "refusal", "request_change", "lapse"]},
          "change": {"oneOf": [
            {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[+-]"}},
            {"type": "object", "minProperties": 1, "properties": {
              "add": {"$ref": "#/$defs/tags"}, "remove": {"$ref": "#/$defs/tags"}, "about": {"type": "string"},
              "replace_fact": {"type": "object", "required": ["id", "with"], "properties": {
                "id": {"type": "string"}, "with": {"$ref": "#/$defs/fact"}}},
              "add_order": {"$ref": "#/$defs/order"}}}]},
          "then": {"oneOf": [{"$ref": "#/$defs/clause"}, {"type": "array", "items": {"$ref": "#/$defs/clause"}, "minItems": 1}]},
          "reason": {"$ref": "#/$defs/tags"}}}},
        "anomaly_cues": {"type": "array", "items": {"type": "object", "required": ["what", "respond"]}},
        "foils": {"type": "array", "items": {"type": "object"}}, "teaching": {"type": "object"}
      }
    },
    "review": {
      "type": "object", "required": ["body", "decision_assessment", "result"],
      "properties": {
        "decision_assessment": {"enum": ["acceptable", "unacceptable"]},
        "result": {"enum": ["good", "bad", "mixed", "unknown"]}
      }
    }
  }
}
